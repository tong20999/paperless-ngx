# Set these four values before the first start.
# Address you will open in your browser, including the scheme and port.
# Examples: http://192.168.1.50:8000 or https://paperless.example.com
PAPERLESS_URL=

# Generate a signing key with: openssl rand -hex 48
PAPERLESS_SECRET_KEY=

# Generate a separate PostgreSQL password with: openssl rand -hex 32
PAPERLESS_DBPASS=

# Initial password for the Paperless web login named admin.
# Use single quotes around passwords containing $ or #.
PAPERLESS_ADMIN_PASSWORD=

# Optional host port. For direct access, use the same port in PAPERLESS_URL.
# PAPERLESS_PORT=8000
